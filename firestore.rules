rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isAdmin() {
      // Using a generic custom claims or email based check.
      // We will check admins collection using the user's uid to be safe.
      // E.g., the document inside /admins/{uid} has { email: "user@example.com" }
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['customerId', 'customerEmail', 'status', 'totalAmount', 'location', 'items', 'createdAt', 'updatedAt'])
        && data.customerId == request.auth.uid
        && data.customerEmail is string && data.customerEmail.size() <= 256
        && data.status is string && data.status in ['Pending Confirmation', 'Shipped', 'Paid', 'Delivered']
        && data.totalAmount is number
        && data.items is list
        && data.location is map
        && data.location.keys().hasAll(['lat', 'lng'])
        && data.location.lat is number
        && data.location.lng is number
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isAdmin() || (isSignedIn() && existing().customerId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && existing().customerId == request.auth.uid);
      
      allow create: if isValidId(orderId) 
        && isSignedIn() 
        && isValidOrder(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
        
      allow update: if isValidId(orderId)
        && (
          (isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            && incoming().updatedAt == request.time
            && incoming().status is string && incoming().status in ['Pending Confirmation', 'Shipped', 'Paid', 'Delivered']
          ) || (
            isSignedIn() && existing().customerId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['reviewed', 'updatedAt'])
            && incoming().reviewed == true
            && incoming().updatedAt == request.time
          )
        );
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
    }

    match /admins/{userId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId && request.auth.token.email == 'shakibulislamj@gmail.com';
    }
    
    match /menuItems/{itemId} {
      allow read: if true;
      allow update: if true;
      allow write: if isAdmin();
    }
    
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
